# Copier en .env puis adapter. Le pont écoute toujours sur 127.0.0.1.

# Port d’écoute (Hermes garde 8642).
PORT=8643

# Jeton que Cornelius présente au pont (32 caractères au moins).
# Générer : openssl rand -hex 32 — puis le coller aussi dans Cornelius,
# Administration → Agents → Jeton de connexion.
BRIDGE_TOKEN=
